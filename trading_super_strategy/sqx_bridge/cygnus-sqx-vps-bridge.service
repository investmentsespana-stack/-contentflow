[Unit]
Description=Cygnus StrategyQuant VPS Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cygnus
Group=cygnus
WorkingDirectory=/opt/cygnus-sqx-vps-bridge
Environment=PYTHONUNBUFFERED=1
Environment=CYGNUS_SQX_CONFIG_DIR=/etc/cygnus-sqx-vps-bridge
Environment=CYGNUS_ALLOW_PROJECT_CONTROL=0
ExecStart=/opt/cygnus-sqx-vps-bridge/.venv/bin/python /opt/cygnus-sqx-vps-bridge/vps_agent.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/cygnus-sqx-vps-bridge
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
