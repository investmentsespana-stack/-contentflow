{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contentflow.ai/schemas/tool-allowlist/v1.json",
  "title": "ContentFlow Tool Allowlist",
  "type": "object",
  "required": ["version", "allowlist_id", "tools"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "allowlist_id": {"type": "string", "pattern": "^allowlist_[A-Za-z0-9_-]{8,64}$"},
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tool_name", "actions"],
        "additionalProperties": false,
        "properties": {
          "tool_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}
          }
        }
      }
    }
  },
  "examples": [{"version":"1.0.0","allowlist_id":"allowlist_prod_2026","tools":[{"tool_name":"web_search","actions":["search"]},{"tool_name":"data_processor","actions":["validate_schema","process_batch"]},{"tool_name":"file_handler","actions":["read_file","upload_file"]}]}]
}
