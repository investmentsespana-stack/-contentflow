{
  "project": "Super Estrategia Adaptativa",
  "version": "0.8",
  "timezone": "America/New_York",
  "markets": ["NQ.v.0", "ES.v.0", "YM.v.0", "RTY.v.0"],
  "operation": {
    "connected_mode": "24x5_research_paper",
    "fixed_entry_window": null,
    "time_is_feature_not_rule": true,
    "session_contexts": ["asia", "london_europe", "new_york", "session_transition"],
    "session_open_emphasis": true,
    "legacy_ny_09_12": "research_hypothesis_only"
  },
  "context_features": [
    "session",
    "minutes_from_session_open",
    "volatility_regime",
    "trend_regime",
    "structure_liquidity",
    "flow_volume",
    "cross_market",
    "macro_event_risk"
  ],
  "confirmations": {
    "required": 4,
    "total": 5,
    "blocks": [
      "context_regime",
      "structure_liquidity",
      "flow_volume",
      "cross_market",
      "strategy_synergy"
    ],
    "macro_fundamental": "modifier_and_veto"
  },
  "strategy_synergy": {
    "single_position_plan": true,
    "independent_strategy_orders": false,
    "require_directional_compatibility": true,
    "require_principle_compatibility": true,
    "prefer_error_diversity": true,
    "conditional_on_regime_session_volatility": true,
    "directional_asymmetry_allowed": true,
    "search_long_and_short_separately": true,
    "same_strategy_may_have_different_long_short_quality": true,
    "combination_search": {
      "mode": "backtest_combinatorial",
      "member_sizes": [2, 3, 4],
      "partition_by": [
        "instrument",
        "session",
        "minutes_from_session_open",
        "volatility_regime",
        "trend_regime",
        "structure_regime"
      ],
      "rank_separately": ["long", "short"],
      "min_sample_required": true,
      "positive_expectancy_required": true,
      "single_coordinated_trade_outcome": true
    },
    "optimize": [
      "win_rate",
      "expectancy",
      "profit_factor",
      "drawdown",
      "oos_stability",
      "diversity",
      "execution_cost"
    ]
  },
  "regime_routing": {
    "bullish": "best_valid_long_coalition",
    "bearish": "best_valid_short_coalition",
    "sideways": "NO_TRADE",
    "unclear": "NO_TRADE",
    "fail_closed": true
  },
  "exit_engine": {
    "coordinated_target": true,
    "strategy_specific_competing_targets": false,
    "adaptive_risk_reward": true,
    "allow_negative_rr_when_positive_ev": true,
    "candidate_reward_r": [0.25, 0.4, 0.5, 0.7, 0.75, 1.0, 1.5, 2.0, 3.0, 4.0],
    "uses": ["session", "volatility", "structure", "liquidity", "mfe_mae", "order_flow", "regime", "time_in_trade"]
  },
  "robustness_gate": {
    "mandatory": true,
    "tests": [
      "train_validation_oos",
      "walk_forward",
      "monte_carlo_trade_bootstrap",
      "missed_trade_stress",
      "slippage_cost_stress",
      "parameter_perturbation",
      "latency_fill_stress",
      "coalition_member_dropout",
      "cscv_pbo",
      "deflated_sharpe",
      "regime_stress"
    ],
    "promotion_requires_positive_oos_expectancy": true,
    "promotion_requires_survival_under_stress": true
  },
  "prop_firm": {
    "enabled_for_research": true,
    "profiles_file": "prop_firm_profiles.json",
    "refresh_rules_before_execution": true,
    "fitness_objective": [
      "payout_probability",
      "account_survival_probability",
      "robust_expectancy",
      "consistency_score",
      "time_to_payout",
      "breach_risk",
      "drawdown_penalty",
      "execution_cost"
    ],
    "same_coalition_may_rank_differently_by_firm_plan_phase": true,
    "negative_rr_is_candidate_not_default": true,
    "reject_if_oos_ev_turns_negative": true
  },
  "execution": {
    "live_money": false,
    "mode": "research_paper_only",
    "fail_closed": true
  }
}
