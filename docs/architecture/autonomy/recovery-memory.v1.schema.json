{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"ContentFlow Recovery Memory V1",
  "type":"object",
  "required":["incident_fingerprint","root_cause","repair_id","evidence_ids","validation","authority","created_at"],
  "properties":{
    "incident_fingerprint":{"type":"string","minLength":16},
    "root_cause":{"type":"string","minLength":1},
    "repair_id":{"type":"string","minLength":1},
    "evidence_ids":{"type":"array","minItems":1,"items":{"type":"string"}},
    "validation":{"enum":["pass","fail"]},
    "authority":{"enum":["rara_autonomous","canary_then_director","owner_required"]},
    "rollback_evidence_id":{"type":["string","null"]},
    "reuse_count":{"type":"integer","minimum":0},
    "created_at":{"type":"string","format":"date-time"}
  },
  "additionalProperties":false
}
